# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: choose sqlite (default) or postgres
DB_ENGINE=sqlite
# If DB_ENGINE=postgres:
POSTGRES_DB=ryu_dashboard
POSTGRES_USER=ryu
POSTGRES_PASSWORD=ryu
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Ryu controller endpoints
RYU_REST_URL=http://127.0.0.1:8080
RYU_WS_URL=ws://127.0.0.1:8080/v1.0/topology/ws
RYU_OFCTL_URL=http://127.0.0.1:8080
CUSTOM_RYU_APP_URL=http://127.0.0.1:8081  # custom_app.py REST endpoint

# Redis (for Channels in production)
REDIS_URL=redis://localhost:6379/0

# GNN
GNN_MODEL_PATH=gnn_security/checkpoints/hybrid_gcn_gat.pt
GNN_THREAT_THRESHOLD=0.75
GNN_MITIGATION_ENABLED=True
